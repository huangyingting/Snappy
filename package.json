{
  "name": "snappy-gifting-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-role corporate gifting platform inspired by Snappy (Next.js + Prisma + SQLite/PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "db:sync:postgres": "node scripts/sync-prisma-provider.mjs postgresql",
    "db:use:sqlite": "node scripts/sync-prisma-provider.mjs sqlite --apply",
    "db:use:postgres": "node scripts/sync-prisma-provider.mjs postgresql --apply",
    "db:validate:all": "prisma validate --schema=prisma/schema.prisma && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snappy prisma validate --schema=prisma/schema.postgres.prisma",
    "setup": "prisma generate && prisma db push --accept-data-loss && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
