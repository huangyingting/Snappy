{
  "name": "snappy-gifting-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Corporate gifting with Next.js, NextAuth and Prisma",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test.mjs --e2e",
    "db:generate": "node scripts/sync-prisma-provider.mjs && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate:all": "node scripts/sync-prisma-provider.mjs --check && prisma validate --schema=prisma/schema.prisma && prisma validate --schema=prisma/postgresql/schema.prisma",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "mail:deliver": "tsx scripts/deliver-mail.ts",
    "setup": "npm run db:generate && npm run db:deploy"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.19.0",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
