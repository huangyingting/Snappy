generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  domain               String
  industry             String              @default("Technology")
  sizeBand             String              @default("201-1000")
  primaryRegion        String              @default("NA")
  logoUrl              String              @default("")
  brandColor           String              @default("#4F46E5")
  walletBalanceCents   Int                 @default(0)
  escrowBalanceCents   Int                 @default(0)
  hideRecipientAddress Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  users                User[]
  walletTransactions   WalletTransaction[]
  collections          Collection[]
  campaigns            Campaign[]
  giftSends            GiftSend[]
}

model Vendor {
  id                String      @id @default(cuid())
  businessName      String
  slug              String      @unique
  taxId             String
  status            String      @default("APPROVED") // PENDING | APPROVED | SUSPENDED
  hqCountry         String      @default("US")
  supportedRegions  String      @default("NA") // Comma-separated: NA,EMEA,APAC,LATAM
  commissionRateBps Int         @default(1500) // 15.00%
  slaDays           Int         @default(3)
  payoutBalanceCents Int        @default(0)
  rating            Float       @default(4.9)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  users             User[]
  products          Product[]
  giftOrders        GiftOrder[]
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  passwordHash        String
  name                String
  role                String             // ADMIN | CORPORATE | VENDOR | RECIPIENT
  jobTitle            String             @default("")
  preferredRegion     String             @default("NA")
  defaultAddressLine1 String             @default("")
  defaultCity         String             @default("")
  defaultState        String             @default("")
  defaultPostalCode   String             @default("")
  defaultCountry      String             @default("US")
  companyId           String?
  company             Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vendorId            String?
  vendor              Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  campaignsCreated    Campaign[]
  receivedGifts       GiftSend[]
  savedAddresses      RecipientAddress[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([companyId])
  @@index([vendorId])
}

model RecipientAddress {
  id                   String   @id @default(cuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail       String
  label                String   @default("Home") // Home | Office | Studio | Family
  recipientName        String
  phone                String   @default("")
  addressLine1         String
  addressLine2         String   @default("")
  city                 String
  state                String   @default("")
  postalCode           String
  country              String   @default("US")
  region               String   @default("NA") // NA | EMEA | APAC | LATAM
  deliveryInstructions String   @default("")
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([recipientEmail])
  @@index([userId])
}

model GiftCategory {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  headline     String    @default("")
  description  String    @default("")
  icon         String    @default("Sparkles")
  accentColor  String    @default("#6366F1")
  heroImageUrl String    @default("")
  displayOrder Int       @default(0)
  isFeatured   Boolean   @default(true)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([displayOrder, active])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         String   // DEPOSIT | ESCROW_HOLD | ESCROW_SURPLUS_REFUND | EXPIRED_GIFT_REFUND | GIFT_SWAP_ADJUSTMENT
  amountCents  Int
  balanceAfter Int
  escrowAfter  Int
  note         String
  referenceId  String   @default("")
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

model Product {
  id                 String              @id @default(cuid())
  vendorId           String
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId         String?
  giftCategory       GiftCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku                String              @default("")
  title              String
  description        String
  category           String              // Audio & Tech | Coffee & Gourmet | Wellness & Spa | Home & Living | Executive Travel | Eco & Impact
  merchandisingBadge String              @default("") // Editor's Pick | Bestseller | Carbon Neutral | Artisan Made | New Arrival
  tagsJson           String              @default("[]")
  variantsJson       String              @default("[]")
  specificationsJson String              @default("{}")
  priceCents         Int
  wholesaleCostCents Int
  imageUrl           String
  stockQuantity      Int                 @default(50)
  supportedRegions   String              @default("NA") // Comma-separated: NA,EMEA,APAC,LATAM
  isFeatured         Boolean             @default(false)
  status             String              @default("ACTIVE") // ACTIVE | OUT_OF_STOCK | ARCHIVED
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  collectionProducts CollectionProduct[]
  giftOrders         GiftOrder[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([priceCents, active])
}

model Collection {
  id                 String              @id @default(cuid())
  title              String
  description        String
  occasion           String              // All Occasions | Onboarding | Anniversary | Birthday | Client VIP | Holiday
  budgetTierCents    Int                 // e.g. 2500, 5000, 10000, 25000
  coverImageUrl      String              @default("")
  isGlobal           Boolean             @default(true)
  companyId          String?
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  collectionProducts CollectionProduct[]
  campaigns          Campaign[]

  @@index([budgetTierCents, isGlobal])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model Charity {
  id                String      @id @default(cuid())
  name              String
  category          String
  description       String
  logoUrl           String      @default("")
  totalDonatedCents Int         @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  giftOrders        GiftOrder[]
}

model Campaign {
  id              String      @id @default(cuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  title           String
  occasion        String
  messageTemplate String
  budgetCents     Int
  collectionId    String?
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  status          String      @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  triggerType     String      @default("MANUAL") // MANUAL | BULK_CSV | AUTOMATED_MILESTONE
  allowCharity    Boolean     @default(true)
  expiresInDays   Int         @default(30)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  giftSends       GiftSend[]

  @@index([companyId])
}

model GiftSend {
  id              String     @id @default(cuid())
  campaignId      String
  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientEmail  String
  recipientName   String
  recipientUserId String?
  recipientUser   User?      @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  preferredRegion String     @default("NA")
  claimToken      String     @unique
  claimCode       String     @unique
  budgetCents     Int
  status          String     @default("SENT") // SENT | OPENED | CLAIMED | PROCESSING | SHIPPED | DELIVERED | DONATED | EXPIRED
  personalMessage String
  thankYouNote    String     @default("")
  expiresAt       DateTime
  claimedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  giftOrder       GiftOrder?

  @@index([companyId, status])
  @@index([recipientEmail])
}

model GiftOrder {
  id                   String          @id @default(cuid())
  giftSendId           String          @unique
  giftSend             GiftSend        @relation(fields: [giftSendId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorId             String?
  vendor               Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  charityId            String?
  charity              Charity?        @relation(fields: [charityId], references: [id], onDelete: SetNull)
  orderType            String          // PHYSICAL_GIFT | CHARITY_DONATION
  retailAmountCents    Int
  vendorPayoutCents    Int             @default(0)
  platformFeeCents     Int             @default(0)
  recipientRegion      String          @default("NA")
  shippingName         String          @default("")
  shippingPhone        String          @default("")
  shippingAddressLine1 String          @default("")
  shippingAddressLine2 String          @default("")
  shippingCity         String          @default("")
  shippingState        String          @default("")
  shippingPostalCode   String          @default("")
  shippingCountry      String          @default("")
  deliveryInstructions String          @default("")
  selectedVariant      String          @default("")
  trackingCarrier      String          @default("")
  trackingNumber       String          @default("")
  trackingUrl          String          @default("")
  serviceLevel         String          @default("International Priority")
  fulfillmentWarehouse String          @default("Newark, NJ (NA-East Hub)")
  packageWeightGrams   Int             @default(650)
  estimatedDeliveryAt  DateTime?
  addressLocked        Boolean         @default(false)
  exceptionNote        String          @default("")
  swapCount            Int             @default(0)
  fulfillmentStatus    String          @default("PENDING_VENDOR") // PENDING_VENDOR | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | COMPLETED | EXCEPTION
  shippedAt            DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  shipmentEvents       ShipmentEvent[]

  @@index([vendorId, fulfillmentStatus])
}

model ShipmentEvent {
  id          String    @id @default(cuid())
  giftOrderId String
  giftOrder   GiftOrder @relation(fields: [giftOrderId], references: [id], onDelete: Cascade)
  stage       String    // ORDER_CONFIRMED | WAREHOUSE_ALLOCATED | PACKED_QA | CARRIER_PICKED_UP | IN_TRANSIT_HUB | CUSTOMS_CLEARED | OUT_FOR_DELIVERY | DELIVERED | ADDRESS_UPDATED | GIFT_SWAPPED | EXCEPTION
  title       String
  description String    @default("")
  location    String    @default("")
  actorRole   String    @default("SYSTEM")
  occurredAt  DateTime  @default(now())

  @@index([giftOrderId, occurredAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole    String
  action       String
  entityType   String
  entityId     String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
